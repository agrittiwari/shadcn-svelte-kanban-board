{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "agrittiwari/kanban-board",
  "items": [
    {
      "name": "kanban",
      "type": "registry:component",
      "title": "Kanban Board",
      "description": "A Svelte 5 Kanban board built from local shadcn-style primitives.",
      "files": [
        {
          "path": "src/lib/components/kanban/KanbanBoard.svelte",
          "type": "registry:component",
          "target": "ui/kanban-board.svelte"
        },
        {
          "path": "src/lib/components/ui/Button.svelte",
          "type": "registry:ui",
          "target": "button.svelte"
        },
        {
          "path": "src/lib/components/ui/Input.svelte",
          "type": "registry:ui",
          "target": "input.svelte"
        },
        {
          "path": "src/lib/components/ui/Textarea.svelte",
          "type": "registry:ui",
          "target": "textarea.svelte"
        },
        {
          "path": "src/lib/components/ui/Badge.svelte",
          "type": "registry:ui",
          "target": "badge.svelte"
        },
        {
          "path": "src/lib/components/ui/Card.svelte",
          "type": "registry:ui",
          "target": "card.svelte"
        },
        {
          "path": "src/lib/kanban.ts",
          "type": "registry:lib",
          "target": "kanban.ts"
        },
        {
          "path": "src/lib/types.ts",
          "type": "registry:lib",
          "target": "types.ts"
        },
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib",
          "target": "utils.ts"
        }
      ],
      "registryDependencies": [],
      "cssVars": {
        "theme": {
          "kanban-board-circle-primary": "var(--primary)"
        },
        "light": {
          "kanban-board-circle-slate": "oklch(0.56 0.02 264)",
          "kanban-board-circle-red": "oklch(0.64 0.21 25)",
          "kanban-board-circle-amber": "oklch(0.8 0.16 86)",
          "kanban-board-circle-green": "oklch(0.72 0.19 149)",
          "kanban-board-circle-cyan": "oklch(0.71 0.12 215)",
          "kanban-board-circle-blue": "oklch(0.62 0.19 259)",
          "kanban-board-circle-violet": "oklch(0.61 0.22 292)",
          "kanban-board-circle-pink": "oklch(0.66 0.21 354)"
        }
      }
    }
  ]
}
