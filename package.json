{
  "name": "shadcn-svelte-kanban-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Svelte 5 Kanban board built with local shadcn-style primitives.",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public/r",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package",
    "build:demo": "vite build",
    "build:example": "vite build --config example/vite.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite",
    "package": "svelte-package",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.7",
    "svelte": "^5.34.2",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
